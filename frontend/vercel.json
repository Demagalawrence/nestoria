{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/booking/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/property/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/payment/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/reviews/(.*)",
      "dest": "/index.html"
    }
  ]
}
